# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# External API Keys
# Get NewsAPI key from: https://newsapi.org/ (free tier: 100 requests/day)
NEXT_PUBLIC_NEWS_API_KEY=your_newsapi_key_here

# Other APIs (optional - for future features)
NEXT_PUBLIC_GNEWS_KEY=
NEXT_PUBLIC_COINGECKO_KEY=
NEXT_PUBLIC_COINMARKETCAP_KEY=
NEXT_PUBLIC_TMDB_KEY=
NEXT_PUBLIC_NSE_KEY=
NEXT_PUBLIC_ALPHAVANTAGE_KEY=
